# API-first GitHub discovery. A fine-grained token with read-only public repository
# access is recommended. Never commit a real token.
GITHUB_TOKEN=

# Optional public-page fallback providers. These are only used after the access
# policy approves the domain and only when proxy escalation is explicitly enabled.
SCRAPINGBEE_API_KEY=
SCRAPEDO_API_KEY=

# Optional scholarly API configuration.
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_MAILTO=research@your-company.com

# ScrapeGraphAI enrichment. Use an Ollama model locally, or an API-backed model.
JURICRATIC_ENABLE_LLM_ENRICHMENT=false
JURICRATIC_LLM_MODEL=ollama/llama3.2
JURICRATIC_LLM_API_KEY=
JURICRATIC_LLM_BASE_URL=

# Safety defaults.
JURICRATIC_RESPECT_ROBOTS=true
JURICRATIC_ALLOW_PROXY_ESCALATION=false
JURICRATIC_ALLOW_FULL_TEXT_FETCH=false
JURICRATIC_ALLOW_JS_RENDERING=false
JURICRATIC_DEFAULT_PROXY_PROVIDER=scrapingbee

# Operational tuning.
JURICRATIC_REQUEST_TIMEOUT_SECONDS=30
JURICRATIC_MAX_RESPONSE_BYTES=8000000
JURICRATIC_MAX_WORKERS=4
JURICRATIC_GITHUB_SEARCH_PAUSE_SECONDS=2.1
JURICRATIC_PROVIDER_PAUSE_SECONDS=0.35
JURICRATIC_RADAR_DB=
